{
  "expo": {
    "name": "Angechat +",
    "slug": "unichat-plus",
    "version": "1.9.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "scheme": "unichatplus",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E7C66"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unichatplus.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Angechat + utilise le micro pour les appels."
      }
    },
    "android": {
      "package": "com.unichatplus.app",
      "versionCode": 19,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7C66"
      },
      "permissions": [
        "CAMERA",
        "READ_CONTACTS",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH_CONNECT",
        "WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Angechat +",
      "shortName": "Angechat +",
      "themeColor": "#0E7C66",
      "backgroundColor": "#FFFFFF",
      "favicon": "./assets/icon.png",
      "lang": "fr"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-contacts",
        {
          "contactsPermission": "Angechat + affiche vos contacts pour vous permettre de leur écrire ou de les inviter."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Angechat + a besoin d'accéder à vos photos pour les partager.",
          "cameraPermission": "Angechat + a besoin de la caméra pour prendre des photos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Angechat + utilise la caméra pour les appels vidéo.",
          "microphonePermission": "Angechat + utilise le micro pour les appels."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://yjfkghrfiwwbtfguovjw.supabase.co",
      "supabaseKey": "sb_publishable_eo1GTfEFLqu38r1rIxLNxg_n48EHA0O"
    }
  }
}